# Connettore Shop DAV -> NTS. Copiare in ".env" (stessa cartella) e compilare.
# Il file .env resta SOLO su questa macchina: mai nel repo, mai in chat o via email.

# --- SQL Server NTS (in LAN) ---------------------------------------------------
# Server e istanza di SQL Server NTS, come in SSMS (es. NOMESERVER\ISTANZA)
MSSQL_SERVER=
# In prova si usa sa; in produzione il login dedicato shop_dav (vedi sql/crea_utente_shop_dav.sql)
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- Supabase (shop in cloud) --------------------------------------------------
# Project Settings → API → Project URL (la stessa NEXT_PUBLIC_SUPABASE_URL dello shop)
SUPABASE_URL=https://<ref-progetto>.supabase.co
# Chiave segreta (service role, sb_secret_...): solo qui, mai nel sito o nel repo
SUPABASE_SERVICE_ROLE_KEY=

# --- Funzionamento -------------------------------------------------------------
# Secondi tra un giro e l'altro
POLL_SECONDI=30
# prova = controlla e scrive in frontiera dentro una transazione annullata (in NTS non arriva niente)
# reale = scrive davvero e NTS crea l'ordine
MODALITA=prova
# Codici cliente NTS separati da virgola che possono passare in automatico. Vuota = tutti.
# Gli ordini degli altri clienti vanno in "errore" con email: l'ufficio li inserisce a mano.
# In prova: solo il codice NTS del cliente usato per i test (vedi brief, piano di prova)
CLIENTI_ABILITATI=

# --- Email di allarme (errore, da verificare, SQL Server irraggiungibile) ------
EMAIL_ALLARMI=info@davsnc.it
# Stessa chiave Resend dello shop. Vuota = le email finiscono solo nel registro.
RESEND_API_KEY=
EMAIL_MITTENTE=DAV Ordini <ordini@davsnc.it>
# Link "apri l'ordine" nelle email
APP_URL=https://shop-dav.dchoban96.workers.dev

# --- Punti aperti del brief (lasciare vuoti finché non sono chiusi) ------------
# Colonna di DAVNTS.dbo.testord dove NTS salva il RIFERIMENTO (trovarla con: npm run cerca-riferimento -- SHOP-000123)
TESTORD_COLONNA_RIFERIMENTO=
# si = passa anche la data di consegna richiesta in GPH_TESTATA_NTS.DATA_CONS (resta comunque nelle note)
USA_DATA_CONS=no

# --- Solo per il piano di prova (punto 5): esce subito dopo il COMMIT ----------
SIMULA_CRASH_DOPO_COMMIT=no
