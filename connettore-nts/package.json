{
  "name": "connettore-nts",
  "version": "1.0.0",
  "private": true,
  "description": "Connettore Shop DAV -> NTS: legge gli ordini confermati da Supabase e li scrive nelle tabelle di frontiera NTS_FRONTIERA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "una-volta": "node dist/index.js --una-volta",
    "controlla": "node dist/controlla.js",
    "cerca-riferimento": "node dist/cerca-riferimento.js",
    "test": "tsx --test src/*.test.ts",
    "tipi": "tsc -p tsconfig.json --noEmit",
    "esplora-prezzi": "node dist/esplora-prezzi.js",
    "esplora-documenti": "node dist/esplora-documenti.js",
    "esplora-sconti": "node dist/esplora-sconti.js",
    "importa-prezzi": "node dist/importa-prezzi.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "mssql": "12.7.11"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
