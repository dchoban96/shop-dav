# Copiare in .env.local e compilare. Mai committare .env.local.

# Sessione (cookie firmato): stringa casuale, almeno 16 caratteri. Obbligatoria in produzione.
AUTH_SECRET=

# Accesso demo: codici cliente ammessi, separati da virgola (login = password = codice).
# In produzione è obbligatoria; in sviluppo, se vuota, è accettato qualsiasi codice.
DEMO_CODICI_CLIENTE=

# Supabase e email: dal passo "schema e accesso su invito" in poi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_ORDINI=info@davsnc.it
APP_URL=http://localhost:3000
